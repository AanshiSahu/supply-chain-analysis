]:
    if cat in df.columns:
        bottleneck_figs.append(delay_pct_fig(cat, title))

# Shipping × Segment heatmap
if 'Shipping Mode' in df.columns and 'Customer Segment' in df.columns:
    hm_data = (df.groupby(['Shipping Mode','Customer Segment'])['Is_Delayed']
