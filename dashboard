def delay_pct_fig(cat, title):
    cdf = (df.groupby(cat)
           .agg(total=('Delay','count'), late=('Is_Delayed','sum'))
           .assign(delay_pct=lambda x: x['late']/x['total']*100)
           .reset_index()
           .sort_values('delay_pct', ascending=True)
           .tail(10))
    fig = px.bar(cdf, x='delay_pct', y=cat, orientation='h',
                 color='delay_pct', color_continuous_scale='viridis',
                 text=cdf['delay_pct'].round(1).astype(str)+'%', title=title,
                 labels={'delay_pct':'Late %', cat:''})
    fig.update_traces(textposition='inside', insidetextanchor='middle')
    fig.update_layout(coloraxis_showscale=False, **PT, height=320)
    return fig

