fig_day.update_traces(textposition='outside')
fig_day.update_layout(coloraxis_showscale=False, **PT, height=360)

# Hour of day
dh = (df.groupby('order_hour')['Is_Delayed'].mean()*100).reset_index()
dh.columns = ['Hour','Delay_Pct']
fig_hour = px.line(dh, x='Hour', y='Delay_Pct', markers=True,
