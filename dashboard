def to_html(fig):
    return fig.to_html(full_html=False, include_plotlyjs=False, config={'displayModeBar': True})

def kpi(label, value, sub="", color="#4FC3F7"):
    return f"""
    <div class="kpi-card" style="border-top:3px solid {color}">
        <div class="kpi-label">{label}</div>
        <div class="kpi-value" style="color:{color}">{value}</div>
        {"<div class='kpi-sub'>"+sub+"</div>" if sub else ""}
    </div>"""

def section(title, insight=""):
    ins = f'<div class="insight">{insight}</div>' if insight else ""
    return f'<div class="section-title">{title}</div>{ins}'

def row(*charts, cols=2):
    width = 100 // cols
    inner = "".join(f'<div style="width:{width}%;min-width:320px">{c}</div>' for c in charts)
    return f'<div class="row">{inner}</div>'

