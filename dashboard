  <button class="tab-btn"        onclick="showTab('eda',   this)">🔍 EDA & Bottlenecks</button>
  <button class="tab-btn"        onclick="showTab('time',  this)">🕐 Time Intelligence</button>
  <button class='tab-btn' onclick="showTab('model',this)">🤖 Model Insights</button>
</nav>

